// ============================================================
// NORVA — Prisma schema
// Commerce backend for a fashion / lifestyle storefront.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum AuthProvider {
  CREDENTIAL
  GOOGLE
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum DiscountScope {
  ALL
  CATEGORY
  PRODUCT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  COD
  SANDBOX
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JournalStatus {
  DRAFT
  PUBLISHED
}

enum ContactStatus {
  NEW
  READ
  REVIEWED
  CLOSED
}

enum InventoryReason {
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  RESERVATION
  RELEASE
}

// ------------------------------------------------------------
// Identity
// ------------------------------------------------------------

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  phone         String?
  passwordHash  String? // null for Google-only accounts
  googleId      String?      @unique
  provider      AuthProvider @default(CREDENTIAL)
  emailVerified Boolean      @default(false)
  role          Role         @default(CUSTOMER)
  status        UserStatus   @default(ACTIVE)
  avatarUrl     String       @default("")
  avatarPublicId String      @default("")
  storeCredit   Decimal      @default(0) @db.Decimal(10, 2)
  marketingOptIn Boolean     @default(false)
  locale        String       @default("en")
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  wishlist         WishlistItem[]
  carts            Cart[]
  sessions         RefreshSession[]
  journalPosts     JournalPost[]
  activityLogs     ActivityLog[]
  inventoryChanges InventoryMovement[]
  createdDiscounts Discount[]
  reviewedReviews  Review[]             @relation("ReviewModerator")

  @@index([role])
  @@index([status])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String      @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postcode   String
  country    String      @default("US")
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}

// ------------------------------------------------------------
// Catalog
// ------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  tagline     String    @default("")
  description String    @default("")
  heroImage   String    @default("")
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
  discounts   Discount[]

  @@index([parentId])
}

model Product {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  subtitle       String        @default("")
  description    String        @default("")
  story          String        @default("")
  material       String        @default("")
  fit            String        @default("")
  care           String        @default("")
  brand          String        @default("NORVA")
  status         ProductStatus @default(ACTIVE)
  featured       Boolean       @default(false)
  price          Decimal       @db.Decimal(10, 2)
  compareAt      Decimal?      @db.Decimal(10, 2)
  cost           Decimal?      @db.Decimal(10, 2)
  currency       String        @default("USD")
  tags           String[]      @default([])
  sizes          String[]      @default([])
  colors         Json          @default("[]") // [{ name, hex }]
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  rating         Float         @default(0)
  ratingCount    Int           @default(0)
  soldCount      Int           @default(0)
  seoTitle       String        @default("")
  seoDescription String        @default("")
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  wishlisted  WishlistItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  movements   InventoryMovement[]
  discounts   Discount[]         @relation("DiscountProducts")

  @@index([categoryId])
  @@index([status, featured])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  publicId  String  @default("")
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  size      String
  color     String
  colorHex  String   @default("")
  price     Decimal? @db.Decimal(10, 2)
  compareAt Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  lowStockThreshold Int @default(3)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ------------------------------------------------------------
// Cart & wishlist
// ------------------------------------------------------------

model Cart {
  id         String     @id @default(uuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  currency   String     @default("USD")
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ------------------------------------------------------------
// Discounts
// ------------------------------------------------------------

model Discount {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String        @default("")
  type          DiscountType
  value         Decimal       @default(0) @db.Decimal(10, 2)
  minOrder      Decimal       @default(0) @db.Decimal(10, 2)
  scope         DiscountScope @default(ALL)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  products      Product[]     @relation("DiscountProducts")
  startsAt      DateTime      @default(now())
  endsAt        DateTime?
  maxUses       Int?
  usedCount     Int           @default(0)
  perUserLimit  Int           @default(1)
  isActive      Boolean       @default(true)
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orders        Order[]

  @@index([isActive])
}

// ------------------------------------------------------------
// Orders & payments
// ------------------------------------------------------------

model Order {
  id             String        @id @default(uuid())
  number         String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  email          String
  phone          String        @default("")
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(10, 2)
  shippingTotal  Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal     Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  couponCode     String?
  discountId     String?
  discount       Discount?     @relation(fields: [discountId], references: [id])
  shippingAddress Json
  billingAddress  Json?
  notes          String        @default("")
  trackingNumber String?
  trackingUrl    String?
  placedAt       DateTime      @default(now())
  confirmedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    OrderItem[]
  events   OrderEvent[]
  payment  Payment?
  reviews  Review[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?        @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  name       String
  slug       String
  image      String          @default("")
  sku        String          @default("")
  size       String          @default("")
  color      String          @default("")
  unitPrice  Decimal         @db.Decimal(10, 2)
  compareAt  Decimal?        @db.Decimal(10, 2)
  quantity   Int
  lineTotal  Decimal         @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderEvent {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String      @default("")
  actorId     String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id           String          @id @default(uuid())
  orderId      String          @unique
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     PaymentProvider @default(STRIPE)
  status       PaymentStatus   @default(PENDING)
  amount       Decimal         @db.Decimal(10, 2)
  currency     String          @default("USD")
  providerRef  String?
  clientSecret String?
  receiptUrl   String?
  paidAt       DateTime?
  refundedAt   DateTime?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ------------------------------------------------------------
// Social proof & editorial
// ------------------------------------------------------------

model Review {
  id               String       @id @default(uuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  orderId          String?
  order            Order?       @relation(fields: [orderId], references: [id])
  customerName     String
  email            String       @default("")
  rating           Int
  title            String       @default("")
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  helpfulCount     Int          @default(0)
  moderatedById    String?
  moderatedBy      User?        @relation("ReviewModerator", fields: [moderatedById], references: [id])
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([productId, status])
  @@index([userId])
}

model JournalPost {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  excerpt     String        @default("")
  body        String        @default("")
  coverImage  String        @default("")
  category    String        @default("Style")
  readTime    Int           @default(4)
  status      JournalStatus @default(DRAFT)
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

// ------------------------------------------------------------
// Growth & operations
// ------------------------------------------------------------

model NewsletterSubscriber {
  id          String    @id @default(uuid())
  email       String    @unique
  locale      String    @default("en")
  source      String    @default("footer")
  isActive    Boolean   @default(true)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String        @default("")
  message   String
  status    ContactStatus @default(NEW)
  reply     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model InventoryMovement {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  delta     Int
  reason    InventoryReason
  note      String          @default("")
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id])
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([createdAt])
}

model MediaAsset {
  id        String   @id @default(uuid())
  url       String
  publicId  String   @default("")
  provider  String   @default("cloudinary")
  folder    String   @default("norva")
  width     Int?
  height    Int?
  alt       String   @default("")
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
