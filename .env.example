# ---------- Server ----------
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ---------- Database ----------
DATABASE_URL="postgresql://norva:norva@localhost:5432/norva?schema=public"

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10
# Comma separated list of admin emails allowed through the staff bootstrap endpoint
ADMIN_EMAILS=admin@norva.store

# ---------- Google OAuth (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Redis (optional — OTP/cache degrade to in-memory) ----------
REDIS_URL=

# ---------- SMTP (optional — emails are logged when empty) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER="NORVA <hello@norva.store>"

# ---------- Cloudinary (optional — uploads fall back to /uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Payments ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ---------- Commerce rules ----------
FREE_SHIPPING_THRESHOLD=100
STANDARD_SHIPPING_FEE=9
TAX_RATE=0.05
CURRENCY=USD
LOYALTY_CASHBACK_PERCENT=2


SEED_ON_BOOT=true

SEED_ADMIN_NAME=Norva Admin
SEED_ADMIN_EMAIL=admin@norva.store
SEED_ADMIN_PASSWORD=NorvaAdmin123!
SEED_STAFF_NAME=Norva Studio
SEED_STAFF_EMAIL=studio@norva.store
SEED_STAFF_PASSWORD=NorvaStudio123!
SEED_CUSTOMER_NAME=Amina Rahman
SEED_CUSTOMER_EMAIL=customer@norva.store
SEED_CUSTOMER_PASSWORD=NorvaCustomer123!
