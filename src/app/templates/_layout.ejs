<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= typeof subject !== "undefined" ? subject : "NORVA" %></title>
  </head>
  <body style="margin:0;padding:0;background:#f6f4f1;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#16150f;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f4f1;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e6e1d9;">
            <tr>
              <td style="padding:28px 32px;border-bottom:1px solid #eee9e1;">
                <span style="font-size:22px;letter-spacing:0.28em;font-weight:600;"><%= brand %></span>
                <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#8a8275;margin-top:4px;"><%= tagline %></div>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <%- body %>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px;background:#faf8f5;color:#8a8275;font-size:11px;line-height:1.7;">
                NORVA — a modern destination for fashion and everyday essentials.<br />
                You're receiving this because you have a NORVA account.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
